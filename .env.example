# Runtime development only. Never put migration or management credentials here.
DATABASE_URL="postgresql://prohaba_runtime_dev.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?schema=prohaba_dev&sslmode=require"
AUTH_SECRET="GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"
AUTH_URL="http://localhost:3000"
# Migration credentials belong in .env.migrations.development.local (ignored).
# Management tokens belong in .env.management.local (ignored).
# Master Data Karyawan bersumber dari E-HSE (server-ke-server, ditandatangani HMAC).
HSE_API_URL="https://prohaba-hse.vercel.app"
HSE_INTEGRATION_SECRET="SAME_AS_INTEGRATION_CENTER_SECRET_IN_EHSE"
