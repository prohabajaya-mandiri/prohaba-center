// ERP PT. Prohaba Jaya Mandiri
// Database Schema — Prisma + Supabase PostgreSQL

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String // TOP_MANAGEMENT | HRD | PJO | LOGISTIK | FINANCE | ENGINEERING | WORKSHOP
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  employee            Employee?
  progressInputs      ProgressItem[]
  boqActuals          BoqActual[]
  attendancesEntered  Attendance[]      @relation("AttendanceEntered")
  attendancesVerified Attendance[]      @relation("AttendanceVerified")
  approvals           PayrollApproval[]
  documents           Document[]
  mrRequests          MaterialRequest[]
  purchaseFlags       PurchaseFlag[]
  auditLogs           AuditLog[]
  fuelLogs            FuelLog[]
  maintenanceLogs     MaintenanceLog[]
}

// ─── PROJECT ──────────────────────────────────────────────────────────────────

model Project {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. PRJ-001
  name          String
  client        String
  location      String
  contractValue Float
  startDate     DateTime
  endDate       DateTime
  status        String   @default("ACTIVE") // ACTIVE | COMPLETED | ON_HOLD
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  boqItems          BOQItem[]
  boqActuals        BoqActual[]
  progressItems     ProgressItem[]
  documents         Document[]
  materialRequests  MaterialRequest[]
  purchaseOrders    PurchaseOrder[]
  purchaseInvoices  PurchaseInvoice[]
  payrolls          Payroll[]
  employees         EmployeeProject[]
  scurveBaselines   SCurveBaseline[]
  salesInvoices     SalesInvoice[]
  fabricationOrders FabricationOrder[]
  fuelLogs          FuelLog[]
  maintenanceLogs   MaintenanceLog[]
}

// ─── S-CURVE & PROGRESS ───────────────────────────────────────────────────────

model BOQItem {
  id            String  @id @default(cuid())
  projectId     String
  // Hierarki
  groupCode     String? // "A", "B", "C" — kelompok besar
  no            String? // "1", "2", "3" — nomor item
  subNo         String? // "a", "b", "c" — sub item
  level         Int     @default(1) // 1=group, 2=item, 3=subitem
  // Identitas
  code          String // e.g. "A.1.a"
  description   String
  unit          String?
  quantity      Float?
  // Harga
  costMaterial  Float? // harga satuan bahan
  costLabor     Float? // harga satuan upah
  totalMaterial Float? // jumlah bahan
  totalLabor    Float? // jumlah upah
  totalPrice    Float? // total harga item
  // Bobot & Jadwal
  weight        Float? // bobot % dari total kontrak (auto-hitung)
  startMonth    String? // "2025-01" (YYYY-MM)
  endMonth      String? // "2025-06"
  category      String  @default("GENERAL") // CIVIL | MECHANICAL | ELECTRICAL | GENERAL
  sortOrder     Int     @default(0)

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  progress ProgressItem[]
  actuals  BoqActual[]
}

model BoqActual {
  id           String   @id @default(cuid())
  boqItemId    String
  projectId    String
  month        String // "2025-01"
  volumeActual Float?
  costActual   Float?
  progressPct  Float? // % progress aktual item ini bulan ini
  notes        String?
  inputBy      String
  createdAt    DateTime @default(now())

  boqItem BOQItem @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [inputBy], references: [id])
}

model SCurveBaseline {
  id        String   @id @default(cuid())
  projectId String
  month     String? // "2025-01" format (optional for backward compat)
  planned   Float // cumulative planned % at this month
  actual    Float? // cumulative actual % (nullable)
  date      DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProgressItem {
  id          String   @id @default(cuid())
  projectId   String
  boqItemId   String
  reportDate  DateTime
  progressPct Float // 0–100
  notes       String?
  photos      String? // JSON array of photo URLs
  inputBy     String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem BOQItem @relation(fields: [boqItemId], references: [id])
  user    User    @relation(fields: [inputBy], references: [id])
}

// ─── ENGINEERING & DOCUMENTS ──────────────────────────────────────────────────

model Document {
  id         String   @id @default(cuid())
  projectId  String
  title      String
  docNumber  String
  revision   String   @default("A")
  category   String // DRAWING | SPECIFICATION | REPORT | CALCULATION
  fileUrl    String
  fileName   String
  fileSize   Int
  targets    String // JSON: ["SITE", "WORKSHOP"] or either
  uploadedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])
  content  DocumentContent?
}

// shortcut: Small private files live in Postgres; move to object storage for larger uploads.
model DocumentContent {
  documentId String @id
  data       Bytes
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ─── MATERIAL REQUEST ─────────────────────────────────────────────────────────

model MaterialRequest {
  id          String   @id @default(cuid())
  mrNumber    String   @unique // MR-2024-001
  projectId   String
  requestedBy String
  status      String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | PO_CREATED
  priority    String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester User           @relation(fields: [requestedBy], references: [id])
  items     MRItem[]
  po        PurchaseOrder?
}

model MRItem {
  id            String  @id @default(cuid())
  mrId          String
  description   String
  unit          String
  quantity      Float
  specification String?

  mr MaterialRequest @relation(fields: [mrId], references: [id])
}

// ─── PROCUREMENT & PURCHASE ORDER ────────────────────────────────────────────

model Vendor {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  npwp      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  poNumber    String   @unique // PO-2024-001
  projectId   String
  vendorId    String
  mrId        String?  @unique
  status      String   @default("CREATED") // CREATED | SENT | CONFIRMED | PARTIAL | DELIVERED | INVOICED
  totalAmount Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  mr              MaterialRequest? @relation(fields: [mrId], references: [id])
  items           POItem[]
  purchaseInvoice PurchaseInvoice?
}

model POItem {
  id           String @id @default(cuid())
  poId         String
  description  String
  unit         String
  quantity     Float
  unitPrice    Float
  totalPrice   Float
  deliveredQty Float  @default(0)

  po PurchaseOrder @relation(fields: [poId], references: [id])
}

// ─── SITE PURCHASE (Anti-Markup) ──────────────────────────────────────────────

model PriceReference {
  id          String   @id @default(cuid())
  itemCode    String   @unique
  description String
  unit        String
  refPrice    Float // harga referensi pasar
  updatedAt   DateTime @updatedAt
}

model SitePurchase {
  id           String   @id @default(cuid())
  projectId    String
  purchaseDate DateTime
  description  String
  vendor       String
  unit         String
  quantity     Float
  unitPrice    Float
  totalAmount  Float
  refPrice     Float? // harga referensi saat pembelian
  priceFlag    Boolean  @default(false) // true jika >10% di atas ref
  flagPct      Float? // % markup terdeteksi
  receiptUrl   String? // bukti struk
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy   String?
  notes        String?
  createdAt    DateTime @default(now())

  flags PurchaseFlag[]
}

model PurchaseFlag {
  id             String   @id @default(cuid())
  sitePurchaseId String
  flaggedBy      String
  reason         String
  createdAt      DateTime @default(now())

  sitePurchase SitePurchase @relation(fields: [sitePurchaseId], references: [id])
  flagger      User         @relation(fields: [flaggedBy], references: [id])
}

// ─── FINANCE (ACCURATE KNOWLEDGE ADAPTATION) ────────────────────────────────

model GLAccount {
  id          String   @id @default(cuid())
  accountNo   String   @unique
  name        String
  accountType String // KAS_BANK | PIUTANG | PERSEDIAAN | AKTIVA_LANCAR_LAINNYA | AKTIVA_TETAP | AKUMULASI_PENYUSUTAN | HUTANG | KEWAJIBAN_JANGKA_PANJANG | EKUITAS | PENDAPATAN | HARGA_POKOK_PENJUALAN | BEBAN | BEBAN_LAIN_LAIN | PENDAPATAN_LAIN_LAIN
  balance     Float    @default(0)
  currency    String   @default("IDR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  journals JournalVoucherItem[]
}

model JournalVoucher {
  id          String   @id @default(cuid())
  journalNo   String   @unique
  date        DateTime
  description String?
  totalAmount Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items        JournalVoucherItem[]
  salesInvoice SalesInvoice?
}

model JournalVoucherItem {
  id               String  @id @default(cuid())
  journalVoucherId String
  glAccountId      String
  description      String?
  debit            Float   @default(0)
  credit           Float   @default(0)

  journalVoucher JournalVoucher @relation(fields: [journalVoucherId], references: [id], onDelete: Cascade)
  glAccount      GLAccount      @relation(fields: [glAccountId], references: [id])
}

model PurchaseInvoice {
  id          String    @id @default(cuid())
  invoiceNo   String    @unique
  projectId   String
  vendorId    String
  poId        String?   @unique
  invoiceDate DateTime
  dueDate     DateTime
  amount      Float
  tax         Float     @default(0)
  totalAmount Float
  status      String    @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE
  paidAmount  Float     @default(0)
  paidDate    DateTime?
  notes       String?
  fileUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor   Vendor            @relation(fields: [vendorId], references: [id])
  po       PurchaseOrder?    @relation(fields: [poId], references: [id])
  payments PurchasePayment[]
}

model PurchasePayment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  payDate   DateTime
  method    String // TRANSFER | CASH | GIRO
  reference String? // nomor transfer
  notes     String?
  createdAt DateTime @default(now())

  purchaseInvoice PurchaseInvoice @relation(fields: [invoiceId], references: [id])
}

model SalesInvoice {
  id          String @id @default(cuid())
  invoiceNo   String @unique
  projectId   String
  description String

  // Nominal & Pajak
  subTotal    Float @default(0)
  taxRate     Float @default(11) // PPN 11%
  taxAmount   Float @default(0)
  totalAmount Float @default(0)

  date     DateTime
  dueDate  DateTime?
  category String // TERMIN | PROGRESS_BILLING | DP | RETENTION_RELEASE
  status   String    @default("UNPAID") // UNPAID | PAID | PARTIAL

  // Relasi Akuntansi
  journalVoucherId String? @unique
  downPaymentId    String? // Merujuk ke ID faktur DP yang dipotong

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  journalVoucher JournalVoucher? @relation(fields: [journalVoucherId], references: [id])
  downPayment    SalesInvoice?   @relation("DownPayment", fields: [downPaymentId], references: [id])
  deductedBy     SalesInvoice[]  @relation("DownPayment")
}

// ─── HR & PAYROLL ─────────────────────────────────────────────────────────────

model Employee {
  id                  String   @id @default(cuid())
  userId              String?  @unique
  employeeNo          String   @unique // EMP-001
  name                String
  nik                 String   @unique // KTP
  position            String
  department          String
  employeeType        String // STAFF | HARIAN | BORONGAN
  baseSalary          Float
  bpjsKetenagakerjaan String?
  bpjsKesehatan       String?
  npwp                String?
  bankAccount         String?
  bankName            String?
  joinDate            DateTime
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         User?             @relation(fields: [userId], references: [id])
  projects     EmployeeProject[]
  attendances  Attendance[]
  payrollItems PayrollItem[]
}

model EmployeeProject {
  id         String    @id @default(cuid())
  employeeId String
  projectId  String
  startDate  DateTime
  endDate    DateTime?
  role       String

  employee Employee @relation(fields: [employeeId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime
  status     String // HADIR | TIDAK_HADIR | IZIN | SAKIT | LIBUR
  overtime   Float     @default(0) // jam lembur
  enteredBy  String
  verifiedBy String?
  verifiedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id])
  enterUser  User     @relation("AttendanceEntered", fields: [enteredBy], references: [id])
  verifyUser User?    @relation("AttendanceVerified", fields: [verifiedBy], references: [id])
}

model Payroll {
  id          String    @id @default(cuid())
  projectId   String
  period      String // "2024-01" format YYYY-MM
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Float
  status      String    @default("DRAFT") // DRAFT | SUBMITTED | HRD_APPROVED | FINANCE_APPROVED | PAID
  notes       String?
  lockedAt    DateTime? // setelah finance approve, tidak bisa diubah
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     PayrollItem[]
  approvals PayrollApproval[]
}

model PayrollItem {
  id          String  @id @default(cuid())
  payrollId   String
  employeeId  String
  workDays    Int
  overtime    Float   @default(0)
  baseSalary  Float
  overtimePay Float   @default(0)
  allowances  Float   @default(0)
  deductions  Float   @default(0)
  bpjsPay     Float   @default(0)
  netSalary   Float
  notes       String?

  payroll  Payroll  @relation(fields: [payrollId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

model PayrollApproval {
  id         String   @id @default(cuid())
  payrollId  String
  approvedBy String
  role       String // HRD | FINANCE | TOP_MANAGEMENT
  action     String // APPROVED | REJECTED
  notes      String?
  createdAt  DateTime @default(now())

  payroll  Payroll @relation(fields: [payrollId], references: [id])
  approver User    @relation(fields: [approvedBy], references: [id])
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // CREATE | UPDATE | DELETE | APPROVE | REJECT
  module    String // PAYROLL | INVOICE | PO | etc.
  recordId  String
  oldValue  String? // JSON
  newValue  String? // JSON
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── WORKSHOP & FABRIKASI ─────────────────────────────────────────────────────

model FabricationOrder {
  id          String    @id @default(cuid())
  orderNumber String    @unique // WO-2024-001
  projectId   String
  description String
  status      String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | DELIVERED
  startDate   DateTime?
  endDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cuttingLists CuttingList[]
  deliveries   DeliveryTicket[]
}

model CuttingList {
  id                 String  @id @default(cuid())
  fabricationOrderId String
  materialName       String
  dimensions         String?
  quantity           Int     @default(1)
  status             String  @default("PENDING") // PENDING | CUT | WELDED | FINISHED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fabricationOrder FabricationOrder @relation(fields: [fabricationOrderId], references: [id], onDelete: Cascade)
}

model DeliveryTicket {
  id                 String   @id @default(cuid())
  ticketNumber       String   @unique // SJ-2024-001
  fabricationOrderId String
  driverName         String?
  vehicleNumber      String?
  deliveryDate       DateTime
  status             String   @default("IN_TRANSIT") // IN_TRANSIT | RECEIVED_AT_SITE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fabricationOrder FabricationOrder @relation(fields: [fabricationOrderId], references: [id], onDelete: Cascade)
}

// ─── KENDARAAN & ALAT BERAT ───────────────────────────────────────────────────

model Vehicle {
  id          String   @id @default(cuid())
  name        String // e.g., Excavator PC 200
  plateNumber String? // e.g., B 1234 XYZ
  code        String?  @unique // e.g., EXC-01
  type        String // ALAT_BERAT | KENDARAAN | GENSET
  status      String   @default("ACTIVE") // ACTIVE | MAINTENANCE | INACTIVE
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]
}

model FuelLog {
  id         String   @id @default(cuid())
  vehicleId  String
  projectId  String?
  date       DateTime
  fuelType   String // SOLAR | DEXLITE | PERTAMAX | etc
  liters     Float
  totalCost  Float
  meterValue Float? // Odometer or Hour Meter
  operator   String?
  notes      String?
  recordedBy String // User ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  user    User     @relation(fields: [recordedBy], references: [id])
}

model MaintenanceLog {
  id          String   @id @default(cuid())
  vehicleId   String
  projectId   String?
  date        DateTime
  type        String // SERVICE | GANTI_OLI | SPAREPART | REPAIR
  description String
  cost        Float
  meterValue        Float? // Odometer or Hour Meter when serviced
  mechanic          String?
  notes             String?
  nextServiceMeter  Float?    // Target HM/km for next replacement
  nextServiceDate   DateTime? // Target date for next service (date-based)
  partName          String?   // Specific part name for SPAREPART type
  recordedBy        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  user    User     @relation(fields: [recordedBy], references: [id])
}
