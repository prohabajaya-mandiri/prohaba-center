// ERP PT. Prohaba Jaya Mandiri
// Database Schema — Prisma + Supabase PostgreSQL

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String // TOP_MANAGEMENT | HRD | PJO | LOGISTIK | FINANCE | ENGINEERING | WORKSHOP
  sessionVersion Int @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  employee            Employee?
  progressInputs      ProgressItem[]
  boqActuals          BoqActual[]
  attendancesEntered  Attendance[]      @relation("AttendanceEntered")
  attendancesVerified Attendance[]      @relation("AttendanceVerified")
  approvals           PayrollApproval[]
  documents           Document[]
  mrRequests          MaterialRequest[]
  purchaseFlags       PurchaseFlag[]
  auditLogs           AuditLog[]
  fuelLogs            FuelLog[]
  maintenanceLogs     MaintenanceLog[]
}

// ─── PROJECT ──────────────────────────────────────────────────────────────────

model Project {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. PRJ-001
  name          String
  client        String
  location      String
  contractValue Decimal @db.Decimal(20, 2)
  startDate     DateTime
  endDate       DateTime
  status        String   @default("ACTIVE") // ACTIVE | COMPLETED | ON_HOLD
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  boqItems          BOQItem[]
  boqActuals        BoqActual[]
  progressItems     ProgressItem[]
  documents         Document[]
  materialRequests  MaterialRequest[]
  purchaseOrders    PurchaseOrder[]
  purchaseInvoices  PurchaseInvoice[]
  payrolls          Payroll[]
  attendances       Attendance[]
  employees         EmployeeProject[]
  scurveBaselines   SCurveBaseline[]
  salesInvoices     SalesInvoice[]
  fabricationOrders FabricationOrder[]
  sitePurchases     SitePurchase[]
  fuelLogs          FuelLog[]
  maintenanceLogs   MaintenanceLog[]
}

// ─── S-CURVE & PROGRESS ───────────────────────────────────────────────────────

model BOQItem {
  id            String  @id @default(cuid())
  projectId     String
  // Hierarki
  groupCode     String? // "A", "B", "C" — kelompok besar
  no            String? // "1", "2", "3" — nomor item
  subNo         String? // "a", "b", "c" — sub item
  level         Int     @default(1) // 1=group, 2=item, 3=subitem
  // Identitas
  code          String // e.g. "A.1.a"
  description   String
  unit          String?
  quantity      Float?
  // Harga
  costMaterial  Decimal? @db.Decimal(20, 2) // harga satuan bahan
  costLabor     Decimal? @db.Decimal(20, 2) // harga satuan upah
  totalMaterial Decimal? @db.Decimal(20, 2) // jumlah bahan
  totalLabor    Decimal? @db.Decimal(20, 2) // jumlah upah
  totalPrice    Decimal? @db.Decimal(20, 2) // total harga item
  // Bobot & Jadwal
  weight        Float? // bobot % dari total kontrak (auto-hitung)
  startMonth    String? // "2025-01" (YYYY-MM)
  endMonth      String? // "2025-06"
  category      String  @default("GENERAL") // CIVIL | MECHANICAL | ELECTRICAL | GENERAL
  sortOrder     Int     @default(0)

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  progress ProgressItem[]
  actuals  BoqActual[]

  @@unique([projectId, code])
  @@index([projectId, sortOrder])
}

model BoqActual {
  id           String   @id @default(cuid())
  boqItemId    String
  projectId    String
  month        String // "2025-01"
  volumeActual Float?
  costActual   Decimal? @db.Decimal(20, 2)
  progressPct  Float? // % progress aktual item ini bulan ini
  notes        String?
  inputBy      String
  createdAt    DateTime @default(now())

  boqItem BOQItem @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [inputBy], references: [id])

  @@unique([boqItemId, month])
  @@index([projectId, month])
}

model SCurveBaseline {
  id        String   @id @default(cuid())
  projectId String
  month     String? // "2025-01" format (optional for backward compat)
  planned   Float // cumulative planned % at this month
  actual    Float? // cumulative actual % (nullable)
  date      DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, date])
}

model ProgressItem {
  id          String   @id @default(cuid())
  projectId   String
  boqItemId   String
  reportDate  DateTime
  progressPct Float // 0–100
  notes       String?
  photos      String? // JSON array of photo URLs
  inputBy     String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem BOQItem @relation(fields: [boqItemId], references: [id])
  user    User    @relation(fields: [inputBy], references: [id])
  @@index([projectId, reportDate])
}

// ─── ENGINEERING & DOCUMENTS ──────────────────────────────────────────────────

model Document {
  id         String   @id @default(cuid())
  projectId  String
  title      String
  docNumber  String
  revision   String   @default("A")
  category   String // DRAWING | SPECIFICATION | REPORT | CALCULATION
  fileUrl    String
  fileName   String
  fileSize   Int
  targets    String // JSON: ["SITE", "WORKSHOP"] or either
  uploadedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploadedBy], references: [id])
  content  DocumentContent?
  @@index([projectId, createdAt])
}

// shortcut: Small private files live in Postgres; move to object storage for larger uploads.
model DocumentContent {
  documentId String @id
  data       Bytes
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ─── MATERIAL REQUEST ─────────────────────────────────────────────────────────

model MaterialRequest {
  id          String   @id @default(cuid())
  mrNumber    String   @unique // MR-2024-001
  projectId   String
  requestedBy String
  status      String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | PO_CREATED
  priority    String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester User           @relation(fields: [requestedBy], references: [id])
  items     MRItem[]
  po        PurchaseOrder?
  @@index([projectId, status])
}

model MRItem {
  id            String  @id @default(cuid())
  mrId          String
  description   String
  unit          String
  quantity      Float
  specification String?

  mr MaterialRequest @relation(fields: [mrId], references: [id])
  @@index([mrId])
}

// ─── PROCUREMENT & PURCHASE ORDER ────────────────────────────────────────────

model Vendor {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  npwp      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  poNumber    String   @unique // PO-2024-001
  projectId   String
  vendorId    String
  mrId        String?  @unique
  status      String   @default("CREATED") // CREATED | SENT | CONFIRMED | PARTIAL | DELIVERED | INVOICED
  totalAmount Decimal @db.Decimal(20, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  mr              MaterialRequest? @relation(fields: [mrId], references: [id])
  items           POItem[]
  purchaseInvoice PurchaseInvoice?
  @@index([projectId, status])
}

model POItem {
  id           String @id @default(cuid())
  poId         String
  description  String
  unit         String
  quantity     Float
  unitPrice    Decimal @db.Decimal(20, 2)
  totalPrice   Decimal @db.Decimal(20, 2)
  deliveredQty Float  @default(0)

  po PurchaseOrder @relation(fields: [poId], references: [id])
  @@index([poId])
}

// ─── SITE PURCHASE (Anti-Markup) ──────────────────────────────────────────────

model PriceReference {
  id          String   @id @default(cuid())
  itemCode    String   @unique
  description String
  unit        String
  refPrice    Decimal @db.Decimal(20, 2) // harga referensi pasar
  updatedAt   DateTime @updatedAt
}

model SitePurchase {
  requestedBy String?
  id           String   @id @default(cuid())
  projectId    String
  purchaseDate DateTime
  description  String
  vendor       String
  unit         String
  quantity     Float
  unitPrice    Decimal @db.Decimal(20, 2)
  totalAmount  Decimal @db.Decimal(20, 2)
  refPrice     Decimal? @db.Decimal(20, 2) // harga referensi saat pembelian
  priceFlag    Boolean  @default(false) // true jika >10% di atas ref
  flagPct      Float? // % markup terdeteksi
  receiptUrl   String? // bukti struk
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy   String?
  notes        String?
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  flags PurchaseFlag[]

  @@index([projectId, purchaseDate])
}

model PurchaseFlag {
  id             String   @id @default(cuid())
  sitePurchaseId String
  flaggedBy      String
  reason         String
  createdAt      DateTime @default(now())

  sitePurchase SitePurchase @relation(fields: [sitePurchaseId], references: [id])
  flagger      User         @relation(fields: [flaggedBy], references: [id])
  @@index([sitePurchaseId])
}

// ─── FINANCE (ACCURATE KNOWLEDGE ADAPTATION) ────────────────────────────────

model GLAccount {
  id          String   @id @default(cuid())
  accountNo   String   @unique
  purpose     String? @unique
  name        String
  accountType String // KAS_BANK | PIUTANG | PERSEDIAAN | AKTIVA_LANCAR_LAINNYA | AKTIVA_TETAP | AKUMULASI_PENYUSUTAN | HUTANG | KEWAJIBAN_JANGKA_PANJANG | EKUITAS | PENDAPATAN | HARGA_POKOK_PENJUALAN | BEBAN | BEBAN_LAIN_LAIN | PENDAPATAN_LAIN_LAIN
  balance     Decimal    @default(0) @db.Decimal(20, 2)
  currency    String   @default("IDR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  journals JournalVoucherItem[]
}

model JournalVoucher {
  id          String   @id @default(cuid())
  journalNo   String   @unique
  projectId String?
  date        DateTime
  description String?
  totalAmount Decimal    @default(0) @db.Decimal(20, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items        JournalVoucherItem[]
  salesInvoice SalesInvoice?
  referenceKey String? @unique
  reversedAt DateTime?
  @@index([projectId, date])
}

model JournalVoucherItem {
  id               String  @id @default(cuid())
  journalVoucherId String
  glAccountId      String
  description      String?
  debit            Decimal   @default(0) @db.Decimal(20, 2)
  credit           Decimal   @default(0) @db.Decimal(20, 2)

  journalVoucher JournalVoucher @relation(fields: [journalVoucherId], references: [id], onDelete: Cascade)
  glAccount      GLAccount      @relation(fields: [glAccountId], references: [id])
  @@index([glAccountId])
}

model PurchaseInvoice {
  id          String    @id @default(cuid())
  invoiceNo   String    @unique
  projectId   String
  vendorId    String
  poId        String?   @unique
  invoiceDate DateTime
  dueDate     DateTime
  amount      Decimal @db.Decimal(20, 2)
  tax         Decimal     @default(0) @db.Decimal(20, 2)
  totalAmount Decimal @db.Decimal(20, 2)
  status      String    @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE
  paidAmount  Decimal     @default(0) @db.Decimal(20, 2)
  paidDate    DateTime?
  notes       String?
  fileUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor   Vendor            @relation(fields: [vendorId], references: [id])
  po       PurchaseOrder?    @relation(fields: [poId], references: [id])
  journalVoucherId String? @unique
  payments PurchasePayment[]

  @@index([projectId, dueDate])
}

model PurchasePayment {
  idempotencyKey String? @unique
  bankAccountId String?
  journalVoucherId String? @unique
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal @db.Decimal(20, 2)
  payDate   DateTime
  method    String // TRANSFER | CASH | GIRO
  reference String? // nomor transfer
  notes     String?
  createdAt DateTime @default(now())

  purchaseInvoice PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  @@index([invoiceId, payDate])
}

model SalesInvoice {
  id          String @id @default(cuid())
  invoiceNo   String @unique
  projectId   String
  description String

  // Nominal & Pajak
  subTotal    Decimal @default(0) @db.Decimal(20, 2)
  taxRate     Decimal @default(11) @db.Decimal(20, 2) // PPN 11%
  taxAmount   Decimal @default(0) @db.Decimal(20, 2)
  totalAmount Decimal @default(0) @db.Decimal(20, 2)

  date     DateTime
  dueDate  DateTime?
  category String // TERMIN | PROGRESS_BILLING | DP | RETENTION_RELEASE
  status   String    @default("UNPAID") // UNPAID | PAID | PARTIAL

  // Relasi Akuntansi
  paidAmount Decimal @default(0) @db.Decimal(20, 2)
  dpUsedAmount Decimal @default(0) @db.Decimal(20, 2)
  appliedDownPayment Decimal @default(0) @db.Decimal(20, 2)
  grossSubTotal Decimal @default(0) @db.Decimal(20, 2)
  journalVoucherId String? @unique
  downPaymentId    String? // Merujuk ke ID faktur DP yang dipotong

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  journalVoucher JournalVoucher? @relation(fields: [journalVoucherId], references: [id])
  downPayment    SalesInvoice?   @relation("DownPayment", fields: [downPaymentId], references: [id])
  deductedBy     SalesInvoice[]  @relation("DownPayment")
  receipts SalesReceipt[]

  @@index([projectId, date])
}

// ─── HR & PAYROLL ─────────────────────────────────────────────────────────────

// Salinan lokal (mirror) master karyawan E-HSE. Sumber data tunggal = E-HSE (Personnel); baris ini dipakai
// sebagai relasi penugasan, absensi dan payroll. Field hasil sinkronisasi tidak diubah langsung di ERP —
// perubahan dilakukan lewat form Master Data Karyawan yang meneruskan ke E-HSE (lib/services/employees.js).
model Employee {
  id                  String    @id @default(cuid())
  userId              String?   @unique
  employeeNo          String    @unique // kode internal E-HSE (PJM-000123); data lama: EMP-001. Tidak ditampilkan ke pengguna
  nip                 String? // NIP dari E-HSE (diisi HRD); kosong sampai dilengkapi
  personnelId         String?   @unique // Personnel.id di E-HSE; null = data lama belum tertaut
  name                String
  nikLast4            String?
  category            String? // STAFF | MANPOWER | HARIAN_KANTOR (E-HSE)
  position            String
  siteCode            String?
  siteName            String?
  workStatus          String? // status kerja E-HSE: ACTIVE | CUTI | SAKIT | MCU | RESIGN | DIRUMAHKAN | MUTASI
  employmentType      String? // PKWT | PKWTT
  contractEndDate     DateTime?
  phoneWa             String?
  bankName            String?
  bpjsKetenagakerjaan String?
  bpjsKesehatan       String?
  joinDate            DateTime? // tanggal mulai di E-HSE
  isActive            Boolean   @default(true) // false bila mantan personel di E-HSE
  hseUpdatedAt        DateTime? // updatedAt E-HSE terakhir yang diterima (kursor sinkronisasi)
  syncedAt            DateTime?
  // Kolom data lama (sebelum terintegrasi E-HSE). Dikosongkan setelah tertaut; jangan dipakai untuk data baru.
  nik                 String?   @unique // NIK utuh hanya disimpan terenkripsi di E-HSE
  department          String?
  employeeType        String? // STAFF | HARIAN | BORONGAN
  baseSalary          Decimal   @default(0) @db.Decimal(20, 2)
  npwp                String?
  bankAccount         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user         User?             @relation(fields: [userId], references: [id])
  projects     EmployeeProject[]
  attendances  Attendance[]
  payrollItems PayrollItem[]

  @@index([isActive, name])
  @@index([hseUpdatedAt])
}

model EmployeeProject {
  id         String    @id @default(cuid())
  employeeId String
  projectId  String
  startDate  DateTime
  endDate    DateTime?
  role       String

  payType String @default("UNSET")
  dailyRate Decimal? @db.Decimal(20, 2)
  monthlyRate Decimal? @db.Decimal(20, 2)
  overtimeRate Decimal? @db.Decimal(20, 2)

  employee Employee @relation(fields: [employeeId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([employeeId, projectId])
  @@index([projectId, startDate])
}

model Attendance {
  projectId String?
  project Project? @relation(fields: [projectId], references: [id])
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime
  status     String // HADIR | TIDAK_HADIR | IZIN | SAKIT | LIBUR
  overtime   Float     @default(0) // jam lembur
  enteredBy  String
  verifiedBy String?
  verifiedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id])
  enterUser  User     @relation("AttendanceEntered", fields: [enteredBy], references: [id])
  verifyUser User?    @relation("AttendanceVerified", fields: [verifiedBy], references: [id])

  @@unique([employeeId, date])
  @@index([date])
}

model Payroll {
  id          String    @id @default(cuid())
  projectId   String
  period      String // "2024-01" format YYYY-MM
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Decimal @db.Decimal(20, 2)
  status      String    @default("DRAFT") // DRAFT | SUBMITTED | HRD_APPROVED | FINANCE_APPROVED | PAID
  notes       String?
  lockedAt    DateTime? // setelah finance approve, tidak bisa diubah
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items     PayrollItem[]
  approvals PayrollApproval[]

  @@unique([projectId, period])
  @@index([status, createdAt])
}

model PayrollItem {
  id          String  @id @default(cuid())
  payrollId   String
  employeeId  String
  workDays    Int
  overtime    Float   @default(0)
  baseSalary  Decimal @db.Decimal(20, 2)
  overtimePay Decimal   @default(0) @db.Decimal(20, 2)
  allowances  Decimal   @default(0) @db.Decimal(20, 2)
  deductions  Decimal   @default(0) @db.Decimal(20, 2)
  bpjsPay     Decimal   @default(0) @db.Decimal(20, 2)
  netSalary   Decimal @db.Decimal(20, 2)
  notes       String?

  payroll  Payroll  @relation(fields: [payrollId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  @@index([payrollId])
}

model PayrollApproval {
  id         String   @id @default(cuid())
  payrollId  String
  approvedBy String
  role       String // HRD | FINANCE | TOP_MANAGEMENT
  action     String // APPROVED | REJECTED
  notes      String?
  createdAt  DateTime @default(now())

  payroll  Payroll @relation(fields: [payrollId], references: [id])
  approver User    @relation(fields: [approvedBy], references: [id])

  @@unique([payrollId, role])
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // CREATE | UPDATE | DELETE | APPROVE | REJECT
  module    String // PAYROLL | INVOICE | PO | etc.
  recordId  String
  oldValue  String? // JSON
  newValue  String? // JSON
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── WORKSHOP & FABRIKASI ─────────────────────────────────────────────────────

model FabricationOrder {
  id          String    @id @default(cuid())
  orderNumber String    @unique // WO-2024-001
  projectId   String
  description String
  status      String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | DELIVERED
  startDate   DateTime?
  endDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cuttingLists CuttingList[]
  deliveries   DeliveryTicket[]
}

model CuttingList {
  id                 String  @id @default(cuid())
  fabricationOrderId String
  materialName       String
  dimensions         String?
  quantity           Int     @default(1)
  status             String  @default("PENDING") // PENDING | CUT | WELDED | FINISHED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fabricationOrder FabricationOrder @relation(fields: [fabricationOrderId], references: [id], onDelete: Cascade)
  @@index([fabricationOrderId])
}

model DeliveryTicket {
  id                 String   @id @default(cuid())
  ticketNumber       String   @unique // SJ-2024-001
  fabricationOrderId String
  driverName         String?
  vehicleNumber      String?
  deliveryDate       DateTime
  status             String   @default("IN_TRANSIT") // IN_TRANSIT | RECEIVED_AT_SITE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fabricationOrder FabricationOrder @relation(fields: [fabricationOrderId], references: [id], onDelete: Cascade)
  @@index([fabricationOrderId, status])
}

// ─── KENDARAAN & ALAT BERAT ───────────────────────────────────────────────────

model Vehicle {
  id          String   @id @default(cuid())
  name        String // e.g., Excavator PC 200
  plateNumber String? // e.g., B 1234 XYZ
  code        String?  @unique // e.g., EXC-01
  type        String // ALAT_BERAT | KENDARAAN | GENSET
  status      String   @default("ACTIVE") // ACTIVE | MAINTENANCE | INACTIVE
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]
}

model FuelLog {
  id         String   @id @default(cuid())
  vehicleId  String
  projectId  String?
  date       DateTime
  fuelType   String // SOLAR | DEXLITE | PERTAMAX | etc
  liters     Float
  totalCost  Decimal @db.Decimal(20, 2)
  meterValue Float? // Odometer or Hour Meter
  operator   String?
  notes      String?
  recordedBy String // User ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  user    User     @relation(fields: [recordedBy], references: [id])
  @@index([projectId, date])
  @@index([vehicleId, date])
}

model MaintenanceLog {
  id          String   @id @default(cuid())
  vehicleId   String
  projectId   String?
  date        DateTime
  type        String // SERVICE | GANTI_OLI | SPAREPART | REPAIR
  description String
  cost        Decimal @db.Decimal(20, 2)
  meterValue        Float? // Odometer or Hour Meter when serviced
  mechanic          String?
  notes             String?
  nextServiceMeter  Float?    // Target HM/km for next replacement
  nextServiceDate   DateTime? // Target date for next service (date-based)
  partName          String?   // Specific part name for SPAREPART type
  recordedBy        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  user    User     @relation(fields: [recordedBy], references: [id])
  @@index([vehicleId, date])
}

model SalesReceipt {
  id String @id @default(cuid())
  invoiceId String
  amount Decimal @db.Decimal(20, 2)
  payDate DateTime
  reference String @unique
  bankAccountId String
  journalVoucherId String @unique
  invoice SalesInvoice @relation(fields: [invoiceId], references: [id])
}

model DocumentSequence {
  key String @id
  value Int @default(0)
}

model LoginAttempt {
  key String @id
  attempts Int @default(0)
  resetAt DateTime
  @@index([resetAt])
}

model PayrollPayment {
 id String @id @default(cuid())
 payrollId String @unique
 amount Decimal @db.Decimal(20, 2)
 payDate DateTime
 bankAccountId String
 reference String @unique
 journalVoucherId String @unique
}

model PurchaseReceipt {
 id String @id @default(cuid())
 poId String
 reference String @unique
 receivedAt DateTime
 items Json
 @@index([poId])
}

model SiteReceipt {
 sitePurchaseId String @id
 data Bytes
 fileName String
}
