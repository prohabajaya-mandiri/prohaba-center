{
  "name": "erp-prohaba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file=.env prisma/seed.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
