    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.21.0",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "^7.8.0"
  },
  "engines": {
    "node": "22.x"
  }
