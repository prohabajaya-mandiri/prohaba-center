    "postinstall": "prisma generate",
    "test": "node --test tests/*.test.mjs"
  },
  "type": "module",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
